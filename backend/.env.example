DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
USE_POSTGRES=True

POSTGRES_DB=kumpas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

KUMPAS_INSTRUCTOR_SIGNUP_PIN=161018
KUMPAS_ADMIN_SIGNUP_PIN=161018

# Email configuration (optional).
#
# Render blocks outbound SMTP ports, so on Render use Resend's HTTP API
# instead (works over normal HTTPS): sign up at resend.com, verify a
# sending domain (or use their onboarding@resend.dev for testing), and set:
# RESEND_API_KEY=re_your_api_key_here
# DEFAULT_FROM_EMAIL=Kumpas <no-reply@yourdomain.com>
#
# For local dev over SMTP (e.g. Gmail with a 2FA App Password) instead:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=yourgmail@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password_here
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Kumpas <yourgmail@gmail.com>
